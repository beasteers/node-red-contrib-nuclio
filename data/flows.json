        "code": "exports.handler = function(context, event) {\n    let body = event.body;\n    if (Buffer.isBuffer(body)) body = body.toString();\n    try {\n        body = JSON.parse(body);\n    } catch (_) {\n        // Keep plain-text request bodies as strings.\n    }\n    context.callback(JSON.stringify({ runtime: \"nodejs\", received: body }));\n};",
