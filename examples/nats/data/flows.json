    {
        "id": "nats-kv-function",
        "type": "nuclio-function",
        "z": "nats-suite-kv",
        "server": "nats-suite-config",
        "project": "nats-suite-project",
        "name": "example-nats-kv-worker",
        "runtime": "python:3.12",
        "sourceType": "sourceCode",
        "codeEntryPath": "",
        "code": "import asyncio\nimport json\nfrom datetime import datetime, timezone\nfrom threading import Thread\nfrom nats.aio.client import Client as NATS\n\nasync def read_value(key):\n    client = NATS()\n    await client.connect(servers=\"nats://nats:4222\")\n    bucket = await client.jetstream().key_value(\"settings\")\n    entry = await bucket.get(key)\n    await client.close()\n    try:\n        return json.loads(entry.value.decode(\"utf-8\"))\n    except json.JSONDecodeError:\n        return entry.value.decode(\"utf-8\")\n\ndef run_async(function, value):\n    result = []\n    errors = []\n    def runner():\n        try:\n            result.append(asyncio.run(function(value)))\n        except Exception as error:\n            errors.append(error)\n    thread = Thread(target=runner)\n    thread.start()\n    thread.join()\n    if errors:\n        raise errors[0]\n    return result[0]\n\ndef handler(context, event):\n    body = event.body\n    if isinstance(body, bytes):\n        body = body.decode(\"utf-8\")\n    if isinstance(body, str):\n        body = json.loads(body)\n    key = body.get(\"key\", \"config.timeout\") if isinstance(body, dict) else \"config.timeout\"\n    return {\"worker\": \"nuclio\", \"key\": key, \"value\": run_async(read_value, key), \"ran_at\": datetime.now(timezone.utc).isoformat()}\n",
        "configCode": "apiVersion: \"nuclio.io/v1\"\nkind: NuclioFunction\nspec:\n  build:\n    commands:\n      - pip install nats-py\n  triggers:\n    nats:\n      kind: nats\n      url: nats://nats:4222\n      attributes:\n        topic: demo.nats.kv.request\n        queueName: demo-nats-kv\n        reply: true\n  disableDefaultHTTPTrigger: true",
        "env_vars": [],
        "deploymentMode": "eager",
        "maxSelfHealAttempts": "2",
        "redeployDeadlineMs": "120000",
        "autoRedeployOnError": "false",
        "autoRedeployOnErrorType": "bool"
    },
