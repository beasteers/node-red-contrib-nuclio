    {
        "id": "nats-jetstream-function",
        "type": "nuclio-function",
        "server": "nats-suite-config",
        "project": "nats-suite-project",
        "name": "example-nats-jetstream-worker",
        "runtime": "python:3.12",
        "sourceType": "sourceCode",
        "codeEntryPath": "",
