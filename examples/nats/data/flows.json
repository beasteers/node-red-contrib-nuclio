    {
        "id": "nats-event-function",
        "type": "nuclio-function",
        "z": "nats-suite-core",
        "server": "nats-suite-config",
        "project": "nats-suite-project",
        "name": "example-nats-event-worker",
        "runtime": "python:3.12",
        "sourceType": "sourceCode",
        "codeEntryPath": "",
        "code": "import asyncio\nimport json\nimport os\nfrom datetime import datetime, timezone\nfrom threading import Thread\n\nfrom nats.aio.client import Client as NATS\n\nasync def publish(value):\n    client = NATS()\n    await client.connect(servers=os.environ.get(\"NATS_URL\", \"nats://nats:4222\"))\n    await client.publish(os.environ.get(\"NATS_OUTPUT_SUBJECT\", \"demo.nats.events.output\"), json.dumps(value).encode())\n    await client.flush()\n    await client.close()\n\ndef _run(value, errors):\n    try:\n        asyncio.run(publish(value))\n    except Exception as error:\n        errors.append(error)\n\ndef handler(context, event):\n    body = event.body\n    if isinstance(body, bytes):\n        body = body.decode(\"utf-8\")\n    if isinstance(body, str):\n        body = json.loads(body)\n    result = {\"worker\": \"nuclio\", \"received\": body, \"ran_at\": datetime.now(timezone.utc).isoformat()}\n    errors = []\n    thread = Thread(target=_run, args=(result, errors))\n    thread.start()\n    thread.join()\n    if errors:\n        raise errors[0]\n    return result",
        "configCode": "apiVersion: \"nuclio.io/v1\"\nkind: NuclioFunction\nspec:\n  build:\n    commands:\n      - pip install nats-py\n  triggers:\n    nats:\n      kind: nats\n      url: nats://nats:4222\n      attributes:\n        topic: demo.nats.events.input\n        queueName: demo-nats-events\n        reply: false\n  disableDefaultHTTPTrigger: true",
        "env_vars": [
            {
                "name": "NATS_URL",
