        "codeEntryUsername": "",
        "codeEntryWorkDir": "",
        "code": "import asyncio\nimport json\nimport os\nfrom datetime import datetime, timezone\nfrom threading import Thread\nfrom nats.aio.client import Client as NATS\n\ndef run_async(function, value):\n    result = []\n    errors = []\n    def runner():\n        try:\n            result.append(asyncio.run(function(value)))\n        except Exception as error:\n            errors.append(error)\n    thread = Thread(target=runner)\n    thread.start()\n    thread.join()\n    if errors:\n        raise errors[0]\n    return result[0]\n\nasync def publish(value):\n    client = NATS()\n    await client.connect(servers=os.environ.get(\"NATS_URL\", \"nats://nats:4222\"))\n    await client.publish(os.environ.get(\"NATS_OUTPUT_SUBJECT\", \"demo.nats.jetstream.output\"), json.dumps(value).encode())\n    await client.flush()\n    await client.close()\n\ndef handler(context, event):\n    body = event.body\n    if isinstance(body, bytes):\n        body = body.decode(\"utf-8\")\n    if isinstance(body, str):\n        body = json.loads(body)\n    result = {\"worker\": \"nuclio\", \"received\": body, \"ran_at\": datetime.now(timezone.utc).isoformat()}\n    run_async(publish, result)\n    return result",
