[
  {
    "id": "k8s-http-tab",
    "type": "tab",
    "label": "Kubernetes HTTP example",
    "disabled": false,
    "info": "Node-RED deploys and invokes a Nuclio HTTP function through the Kubernetes dashboard service.",
    "env": []
  },
  {
    "id": "k8s-http-server",
    "type": "nuclio-config",
    "address": "NUCLIO_DASHBOARD_URL",
    "addressType": "env",
    "namespace": "NUCLIO_NAMESPACE",
    "namespaceType": "env",
    "publicAddress": "NUCLIO_DASHBOARD_URL",
    "publicAddressType": "env",
    "invocationUrlPreference": "service",
    "internalInvocationServiceHost": "nuclio-{function}",
    "internalInvocationServiceHostType": "str",
    "externalInvocationProtocol": "http",
    "deploymentPolicy": "managed",
    "requestTimeoutMs": "10000",
    "deployTimeoutMs": "60000"
  },
  {
    "id": "k8s-http-project",
    "type": "nuclio-project",
    "name": "NUCLIO_PROJECT",
    "nameType": "env"
  },
  {
    "id": "k8s-http-function",
    "type": "nuclio-function",
    "server": "k8s-http-server",
    "project": "k8s-http-project",
    "name": "example-http-k8s",
    "runtime": "python:3.12",
    "sourceType": "sourceCode",
    "codeEntryPath": "",
    "code": "import json\nimport os\n\ndef handler(context, event):\n    body = event.body\n    if isinstance(body, bytes):\n        body = body.decode('utf-8')\n    if isinstance(body, str):\n        try:\n            body = json.loads(body)\n        except ValueError:\n            pass\n    return {'runtime': 'python', 'transport': 'http', 'received': body, 'secret_configured': bool(os.environ.get('DEMO_API_KEY'))}",
    "configCode": "apiVersion: \"nuclio.io/v1\"\nkind: NuclioFunction\nspec:\n  minReplicas: 1\n  maxReplicas: 1\n  env:\n    - name: DEMO_API_KEY\n      valueFrom:\n        secretKeyRef:\n          name: example-http-secret\n          key: api-key\n  triggers:\n    default-http:\n      kind: http\n      maxWorkers: 2",
    "env_vars": [],
    "deploymentMode": "eager",
    "executionTriggerName": "http",
    "maxSelfHealAttempts": "2",
    "redeployDeadlineMs": "120000",
    "autoRedeployOnError": "false",
    "autoRedeployOnErrorType": "bool"
  },
  {
    "id": "k8s-http-inject",
    "type": "inject",
    "z": "k8s-http-tab",
    "name": "Invoke HTTP example",
    "props": [{"p": "payload"}],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"message\":\"hello from Kubernetes\"}",
    "payloadType": "json",
    "x": 180,
    "y": 160,
    "wires": [["k8s-http-invoke"]]
  },
  {
    "id": "k8s-http-invoke",
    "type": "nuclio",
    "z": "k8s-http-tab",
    "function": "k8s-http-function",
    "name": "",
    "timeoutMs": "10000",
    "maxInFlight": "4",
    "retries": "0",
    "retryDelayMs": "500",
    "headers": [],
    "x": 450,
    "y": 160,
    "wires": [["k8s-http-response"], ["k8s-http-error"]]
  },
  {
    "id": "k8s-http-response",
    "type": "debug",
    "z": "k8s-http-tab",
    "name": "HTTP response",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 690,
    "y": 140,
    "wires": []
  },
  {
    "id": "k8s-http-error",
    "type": "debug",
    "z": "k8s-http-tab",
    "name": "HTTP error",
    "active": true,
    "tosidebar": true,
    "complete": "true",
    "targetType": "full",
    "x": 680,
    "y": 200,
    "wires": []
  }
]
