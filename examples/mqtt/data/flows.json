    "id": "0000000000000080",
    "type": "nuclio-function",
    "z": "0000000000000077",
    "server": "0000000000000001",
    "project": "0000000000000078",
    "name": "example-mqtt-transform",
    "runtime": "python:3.12",
    "sourceType": "sourceCode",
    "codeEntryPath": "",
    "codeEntryBranch": "",
    "codeEntryTag": "",
    "codeEntryReference": "",
    "codeEntryUsername": "",
    "codeEntryWorkDir": "",
    "code": "import json\nimport os\nfrom urllib.parse import urlparse\n\nimport paho.mqtt.client as mqtt\n\n_client = None\n\ndef _publish(value):\n    global _client\n    if _client is None:\n        broker = urlparse(os.environ.get('MQTT_BROKER_URL', 'mqtt://mosquitto:1883'))\n        _client = mqtt.Client()\n        _client.connect(broker.hostname, broker.port or 1883, 60)\n        _client.loop_start()\n    info = _client.publish(os.environ.get('MQTT_OUTPUT_TOPIC', 'example/mqtt/output'), json.dumps(value), qos=0)\n    info.wait_for_publish()\n    if info.rc != mqtt.MQTT_ERR_SUCCESS:\n        raise RuntimeError('failed to publish MQTT output')\n\ndef handler(context, event):\n    body = event.body\n    if isinstance(body, bytes):\n        body = body.decode('utf-8')\n    if isinstance(body, str):\n        try:\n            body = json.loads(body)\n        except ValueError:\n            pass\n    result = {'trigger': 'mqtt', 'topic': getattr(event, 'path', ''), 'received': body}\n    _publish(result)\n    return result",
    "configCode": "apiVersion: \"nuclio.io/v1\"\nkind: NuclioFunction\nspec:\n  build:\n    commands:\n      - pip install paho-mqtt\n  triggers:\n    mqtt:\n      kind: mqtt\n      url: mosquitto:1883\n      attributes:\n        subscriptions:\n          - topic: example/mqtt/input\n            qos: 0",
    "env_vars": [
      {
        "name": "MQTT_BROKER_URL",
        "value": "mqtt://mosquitto:1883",
        "type": "str"
      },
